# Claude API Configuration
ANTHROPIC_API_KEY=your_api_key_here
# Default model - users can override in the UI
# Valid models: claude-opus-4-5-20251101, claude-sonnet-4-5-20241022
CLAUDE_MODEL=claude-opus-4-5-20251101

# Execution Configuration
MAX_EXECUTION_TIME=300
MAX_RETRIES=3

# Output Configuration
OUTPUTS_DIR=outputs
NOTEBOOKS_DIR=outputs/notebooks
PLOTS_DIR=outputs/plots

# CORE API Configuration (required - register at https://core.ac.uk/services/api)
CORE_API_KEY=your_core_api_key_here

# PubMed API Configuration (optional - for higher rate limits)
NCBI_API_KEY=your_ncbi_api_key_here
